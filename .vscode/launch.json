{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Rust tests",
            "cargo": {
                "args": [
                    "test",
                    "--no-run"
                ],
                "filter": {
                    "kind": "bin"
                }
            },
            "args": [
                "--test-threads=1",
                "--nocapture"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}